# Copy to .env and supply deployment values. Load with uvicorn --env-file .env.
DATA_SOURCE=clickhouse
MOCK_DATA=false
CLICKHOUSE_URL=https://clickhouse.example.internal:8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=analytics_readonly
CLICKHOUSE_PASSWORD=
CLICKHOUSE_VERIFY_SSL=true
API_CORS_ORIGINS=https://analytics.example.internal

# Persist all three files on a writable, backed-up volume.
APP_USERS_DB=./data/app_users.sqlite3
APP_CONFIGURATION_DB=./data/app_configuration.sqlite3
APP_BI_DB=./data/app_bi.sqlite3
APP_BI_VIEWER_DEFAULT_SCOPE=NONE
APP_SESSION_COOKIE_SECURE=true

KEYCLOAK_ENABLED=true
KEYCLOAK_ISSUER=https://keycloak.example.internal/realms/analytics
KEYCLOAK_CLIENT_ID=analytics-ui
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://analytics.example.internal/api/auth/keycloak/callback
KEYCLOAK_FRONTEND_URL=https://analytics.example.internal
# Optional realm role, used only to bootstrap a new application's administrator.
KEYCLOAK_ADMIN_ROLE=analytics-administrator
KEYCLOAK_ALLOW_HTTP=false

# Optional local-account bootstrap only when KEYCLOAK_ENABLED=false.
# Generate a private random token; pass it as X-App-Admin-Token when creating
# the first administrator. Never use a fixed/shared default token.
APP_ADMIN_TOKEN=
